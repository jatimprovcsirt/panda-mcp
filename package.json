{
  "name": "@jatimprovcsirt/panda-mcp",
  "version": "0.1.0",
  "description": "PANDA documentation and validation server for AI coding assistants. Read-only, no network, no keys.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "panda-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "panda",
    "encryption",
    "pdp",
    "indonesia"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:content": "tsx scripts/build-content.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:no-network": "tsx scripts/check-no-network.ts",
    "check:content": "tsx scripts/check-content-freshness.ts",
    "check:version": "tsx scripts/check-version.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
